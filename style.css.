body {
  font-family: Arial, sans-serif;
  text-align: center;
  background: #f4f4f9;
  margin: 0;
  padding: 0;
}

header {
  background: #333;
  color: white;
  padding: 20px;
}

button {
  background: teal;
  color: white;
  padding: 10px 20px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
}

button:hover {
  background: darkcyan;
}